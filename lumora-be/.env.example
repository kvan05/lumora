# Backend Environment Variables Example
NODE_ENV=development
PORT=5001

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@host:5432/neondb?sslmode=require"

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS / Allowed Frontend URLs (comma-separated for multi-domain)
FRONTEND_URL=http://localhost:3000

# PayOS (VietQR Payment Gateway)
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_WEBHOOK_SECRET=your_payos_webhook_secret

# Resend (Email Service)
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@lumora.pro.vn

# Seed Credentials (Required when running `npm run seed`)
# Passwords must be provided via environment variables in production/staging!
ADMIN_PASSWORD=
SELLER_PASSWORD=
BUYER_PASSWORD=
