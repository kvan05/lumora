generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  username         String?           @unique
  email            String            @unique
  name             String?
  password         String?
  avatar           String?
  phone            String?
  role             String            @default("BUYER")
  isVerified       Boolean           @default(false)
  locale           String            @default("vi")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  AdminLog         AdminLog[]
  approvedEvents   Event[]           @relation("EventApprover")
  events           Event[]           @relation("SellerEvents")
  favorites        Favorite[]
  notifications    Notification[]
  orders           Order[]
  OrganizerProfile OrganizerProfile?
  RefundRequest    RefundRequest[]
  Report           Report[]
  Review           Review[]
  sessions         UserSession[]
  Withdrawal       Withdrawal[]
  bankAccounts     SellerBankAccount[]
  staffMember      StaffMember?      @relation("StaffUser")
  managedStaff     StaffMember[]     @relation("SellerStaff")

  @@map("users")
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

model Otp {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, code])
  @@map("otps")
}

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  otp       String
  password  String
  name      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("email_verifications")
}

model Event {
  id                String             @id @default(cuid())
  sellerId          String
  title             String
  slug              String             @unique
  description       String
  bannerUrl         String?
  imageUrls         String?
  category          String
  venue             String
  address           String
  city              String
  latitude          Float?
  longitude         Float?
  startDate         DateTime
  endDate           DateTime
  status            String             @default("DRAFT")
  approvalNote      String?
  approvedAt        DateTime?
  approvedById      String?
  pendingChanges    String?
  editRequestStatus String?
  isFeatured        Boolean            @default(false)
  hasSeatMap        Boolean            @default(false)
  refundPolicy      String?
  termsConditions   String?
  tags              String?
  metaTitle         String?
  metaDesc          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  EventApprovalLog  EventApprovalLog[]
  approvedBy        User?              @relation("EventApprover", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  seller            User               @relation("SellerEvents", fields: [sellerId], references: [id])
  favorites         Favorite[]
  orders            Order[]
  Review            Review[]
  seatSections      SeatSection[]
  Settlement        Settlement?
  ticketTypes       TicketType[]

  staffAssignments StaffEventAssignment[]
  checkinLogs      CheckinLog[]

  @@map("events")
}

model TicketType {
  id            String           @id @default(cuid())
  eventId       String
  name          String
  description   String?
  price         Decimal          @db.Decimal(12, 2)
  originalPrice Decimal?         @db.Decimal(12, 2)
  quantity      Int
  maxPerOrder   Int              @default(10)
  saleStart     DateTime?
  saleEnd       DateTime?
  status        String           @default("ACTIVE")
  sortOrder     Int              @default(0)
  color         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  orderItems    OrderItem[]
  inventory     TicketInventory?
  event         Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("ticket_types")
}

model TicketInventory {
  id           String     @id @default(cuid())
  ticketTypeId String     @unique
  totalQty     Int
  reservedQty  Int        @default(0)
  soldQty      Int        @default(0)
  updatedAt    DateTime   @updatedAt
  ticketType   TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)

  @@map("ticket_inventories")
}

model SeatSection {
  id          String    @id @default(cuid())
  eventId     String
  name        String
  label       String
  color       String?
  price       Decimal   @db.Decimal(12, 2)
  rowCount    Int       @default(0)
  seatsPerRow Int       @default(0)
  sortOrder   Int       @default(0)
  rows        SeatRow[]
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("seat_sections")
}

model SeatRow {
  id        String      @id @default(cuid())
  sectionId String
  rowLabel  String
  sortOrder Int         @default(0)
  section   SeatSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  seats     Seat[]

  @@map("seat_rows")
}

model Seat {
  id         String      @id @default(cuid())
  rowId      String
  seatNumber String
  seatLabel  String
  status     String      @default("AVAILABLE")
  reservedBy String?
  reservedAt DateTime?
  expiresAt  DateTime?
  orderItems OrderItem[]
  row        SeatRow     @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@map("seats")
}

model Order {
  id            String         @id @default(cuid())
  orderNumber   String         @unique
  buyerId       String
  eventId       String
  status        String         @default("PENDING")
  subtotal      Decimal        @db.Decimal(12, 2)
  fees          Decimal        @default(0) @db.Decimal(12, 2)
  discount      Decimal        @default(0) @db.Decimal(12, 2)
  total         Decimal        @db.Decimal(12, 2)
  currency      String         @default("VND")
  voucherCode   String?
  notes         String?
  expiresAt     DateTime
  confirmedAt   DateTime?
  checkedInAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         OrderItem[]
  buyer         User           @relation(fields: [buyerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event         Event          @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment       Payment?
  RefundRequest RefundRequest?

  @@map("orders")
}

model OrderItem {
  id           String      @id @default(cuid())
  orderId      String
  ticketTypeId String?
  seatId       String?
  quantity     Int         @default(1)
  unitPrice    Decimal     @db.Decimal(12, 2)
  subtotal     Decimal     @db.Decimal(12, 2)
  qrCode       String?
  ticketCode   String?     @unique
  isCheckedIn  Boolean     @default(false)
  checkedInAt  DateTime?
  createdAt    DateTime    @default(now())
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seat         Seat?       @relation(fields: [seatId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_items")
}

model Payment {
  id             String        @id @default(cuid())
  orderId        String        @unique
  payosOrderCode BigInt        @unique
  payosPaymentId String?       @unique
  checkoutUrl    String
  qrCode         String?
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("VND")
  status         String        @default("PENDING")
  failureReason  String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id])
  transactions   Transaction[]

  @@map("payments")
}

model Transaction {
  id           String   @id @default(cuid())
  paymentId    String
  payosEventId String   @unique
  type         String
  amount       Decimal  @db.Decimal(12, 2)
  status       String
  rawPayload   String
  createdAt    DateTime @default(now())
  payment      Payment  @relation(fields: [paymentId], references: [id])

  @@map("transactions")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  metadata  String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  parentId      String?
  createdAt     DateTime   @default(now())
  parent        Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcategories Category[] @relation("SubCategories")

  @@map("categories")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@map("favorites")
}

model Voucher {
  id            String   @id @default(cuid())
  code          String   @unique
  discountType  String
  discountValue Decimal  @db.Decimal(12, 2)
  maxDiscount   Decimal? @db.Decimal(12, 2)
  minOrderValue Decimal? @db.Decimal(12, 2)
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int      @default(0)
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())

  @@map("vouchers")
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  eventId   String
  rating    Int
  content   String
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("reviews")
}

model RefundRequest {
  id        String   @id @default(cuid())
  orderId   String   @unique
  userId    String
  reason    String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  order     Order    @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refund_requests")
}

model Report {
  id         String   @id @default(cuid())
  reporterId String
  targetType String
  targetId   String
  reason     String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model Content {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  type        String
  contentHtml String?
  imageUrl    String?
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("contents")
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@map("admin_logs")
}

model OrganizerProfile {
  id             String              @id @default(cuid())
  userId         String              @unique
  orgName        String
  orgLogo        String?
  orgBanner      String?
  orgDescription String?
  website        String?
  facebook       String?
  address        String?
  representative String?
  verifyStatus   String              @default("PENDING")
  rejectReason   String?
  reviewedAt     DateTime?
  reviewedBy     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  bankInfo       OrganizerBankInfo?
  documents      OrganizerDocument[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("organizer_profiles")
}

model OrganizerDocument {
  id        String           @id @default(cuid())
  profileId String
  docType   String
  docUrl    String
  createdAt DateTime         @default(now())
  profile   OrganizerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("organizer_documents")
}

model OrganizerBankInfo {
  id            String           @id @default(cuid())
  profileId     String           @unique
  bankName      String
  accountNumber String
  accountHolder String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  profile       OrganizerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("organizer_bank_info")
}

model Settlement {
  id             String    @id @default(cuid())
  eventId        String    @unique
  sellerId       String
  grossRevenue   Decimal   @db.Decimal(14, 2)
  commissionRate Decimal   @db.Decimal(5, 4)
  commissionFee  Decimal   @db.Decimal(14, 2)
  perTicketFee   Decimal   @default(0) @db.Decimal(14, 2)
  netAmount      Decimal   @db.Decimal(14, 2)
  status         String    @default("PENDING")
  note           String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  event          Event     @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("settlements")
}

model Withdrawal {
  id            String    @id @default(cuid())
  sellerId      String
  amount        Decimal   @db.Decimal(14, 2)
  bankName      String
  accountNumber String
  accountHolder String
  status        String    @default("PENDING")
  adminNote     String?
  processedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  seller        User      @relation(fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("withdrawals")
}

model SellerBankAccount {
  id            String   @id @default(cuid())
  sellerId      String
  bankName      String
  accountNumber String
  accountHolder String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  seller        User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_bank_accounts")
}

model EventApprovalLog {
  id        String   @id @default(cuid())
  eventId   String
  adminId   String
  action    String
  note      String?
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_approval_logs")
}

model StaffMember {
  id          String                @id @default(cuid())
  userId      String                @unique
  sellerId    String
  isActive    Boolean               @default(true)
  note        String?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation("StaffUser", fields: [userId], references: [id], onDelete: Cascade)
  seller      User                  @relation("SellerStaff", fields: [sellerId], references: [id], onDelete: Cascade)
  assignments StaffEventAssignment[]

  @@map("staff_members")
}

model StaffEventAssignment {
  id            String      @id @default(cuid())
  staffMemberId String
  eventId       String
  assignedAt    DateTime    @default(now())
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([staffMemberId, eventId])
  @@map("staff_event_assignments")
}

model CheckinLog {
  id          String   @id @default(cuid())
  ticketCode  String
  orderItemId String?
  eventId     String
  staffUserId String
  sellerId    String
  action      String   // SUCCESS | ALREADY_CHECKED_IN | WRONG_EVENT | INVALID | CANCELLED
  note        String?
  scannedAt   DateTime @default(now())
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, scannedAt])
  @@index([staffUserId, scannedAt])
  @@map("checkin_logs")
}

model RiskAlert {
  id              String    @id @default(cuid())
  entityType      String
  entityId        String
  riskScore       Int
  riskLevel       String
  reasons         String
  status          String    @default("OPEN")
  assignedAdminId String?
  adminNote       String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("risk_alerts")
}

model Reconciliation {
  id                String    @id @default(cuid())
  periodName        String?
  startDate         DateTime
  endDate           DateTime
  totalOrdersCount  Int
  grossRevenue      Decimal   @db.Decimal(14, 2)
  refundedAmount    Decimal   @db.Decimal(14, 2)
  platformFee       Decimal   @db.Decimal(14, 2)
  sellerPayout      Decimal   @db.Decimal(14, 2)
  outstandingAmount Decimal   @db.Decimal(14, 2)
  expectedAmount    Decimal   @db.Decimal(14, 2)
  actualAmount      Decimal   @db.Decimal(14, 2)
  discrepancy       Decimal   @db.Decimal(14, 2)
  status            String    @default("BALANCED")
  createdById       String?
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("reconciliations")
}

